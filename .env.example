# Local development configuration. Never commit a real .env file.
BSKY_HANDLE=
BSKY_APP_PASSWORD=
DATABASE_URL=sqlite:///./data/bsky_bot.db
LOG_LEVEL=INFO
LOG_FILE=logs/bsky-bot.log
DRY_RUN=true
FOLLOW_DELAY_MIN_SECONDS=60
FOLLOW_DELAY_MAX_SECONDS=180
MAX_FOLLOWS_PER_DAY=30
MAX_FOLLOWERS=300
SEARCH_KEYWORDS=furry art,3d model,2d model,vtuber
RECENT_POST_LIMIT=10

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
SESSION_MAX_AGE_HOURS=24
